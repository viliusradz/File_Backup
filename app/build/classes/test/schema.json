{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"repo_path",
		"repo_url",
		"repo_type",
		"backup_items"
	],
	"properties": {
		"repo_path": {
			"type": "string"
		},
		"repo_url": {
			"type": "string",
			"description": "defines where to push files to"
		},
		"repo_type": {
			"enum": [
				"private",
				"public"
			]
		},
		"backup_items": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"source",
					"destination"
				],
				"properties": {
					"source": {
						"type": "string"
					},
					"destination": {
						"type": "string",
						"description": "Local path, where the file should be stored"
					}
				}
			}
		},
		"features": {
			"type": "array",
			"items": {
				"type": "string"
			}
		}
	}
}
